<Analytics />
<style>
  /* ============ TOKENS ============ */
  :root {
    --ink:        #1B2420;
    --ink-soft:   #56604F;
    --ink-faint:  #8B927F;
    --paper:      #F2F5EA;
    --paper-raised:#FCFDF8;
    --line:       #C7D3B9;
    --line-strong:#9FAE8C;
    --brass:      #93691F;
    --brass-ink:  #FCFDF8;
    --red:        #8C3327;
    --shadow:     rgba(30, 38, 24, 0.10);
    --radius-sm:  3px;
    --radius-md:  6px;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --mono: ui-monospace, "SF Mono", "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ink:        #E9EDE1;
      --ink-soft:   #A6AF98;
      --ink-faint:  #707868;
      --paper:      #10140D;
      --paper-raised:#171C12;
      --line:       #2C3624;
      --line-strong:#3D4A31;
      --brass:      #D4A94F;
      --brass-ink:  #14180F;
      --red:        #D06D5D;
      --shadow:     rgba(0, 0, 0, 0.45);
    }
  }
  :root[data-theme="dark"] {
    --ink:        #E9EDE1;
    --ink-soft:   #A6AF98;
    --ink-faint:  #707868;
    --paper:      #10140D;
    --paper-raised:#171C12;
    --line:       #2C3624;
    --line-strong:#3D4A31;
    --brass:      #D4A94F;
    --brass-ink:  #14180F;
    --red:        #D06D5D;
    --shadow:     rgba(0, 0, 0, 0.45);
  }

  /* ============ BASE ============ */
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16.5px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .container { max-width: 1040px; margin: 0 auto; padding: 0 28px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 700; text-wrap: balance; margin: 0; }
  a { color: inherit; }
  img, svg { max-width: 100%; display: block; }
  .tabular { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  ::selection { background: var(--brass); color: var(--brass-ink); }
  a:focus-visible, button:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 3px;
  }

  /* ============ NAV ============ */
  .nav {
    position: sticky; top: 0; z-index: 30;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 0;
  }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand-mark {
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--ink); color: var(--paper-raised);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--serif); font-weight: 700; font-size: 13px;
    border: 1px solid var(--line-strong);
  }
  .brand-name { font-family: var(--serif); font-weight: 700; font-size: 16.5px; }
  .nav-links { display: flex; gap: 26px; font-size: 14px; color: var(--ink-soft); }
  .nav-links a { text-decoration: none; }
  .nav-links a:hover { color: var(--brass); }
  @media (max-width: 700px) { .nav-links { display: none; } }

  /* ============ BUTTONS (ink-stamp) ============ */
  .stamp-btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--mono); font-size: 13px; letter-spacing: .04em; text-transform: uppercase;
    padding: 11px 20px;
    background: transparent;
    color: var(--brass);
    border: 1.5px solid var(--brass);
    border-radius: var(--radius-sm);
    text-decoration: none;
    cursor: pointer;
    transition: transform .15s ease, background .15s ease, color .15s ease;
    transform: rotate(-1deg);
  }
  .stamp-btn:hover { background: var(--brass); color: var(--brass-ink); transform: rotate(-1deg) scale(0.97); }
  .stamp-btn.solid { background: var(--brass); color: var(--brass-ink); }
  .stamp-btn.solid:hover { background: transparent; color: var(--brass); }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    padding: 76px 0 64px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center;
  }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero h1 {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .hero h1 em { font-style: normal; color: var(--red); }
  .hero-sub {
    margin-top: 18px; font-size: 17.5px; color: var(--ink-soft); max-width: 46ch;
  }
  .hero-cta { display: flex; gap: 14px; margin-top: 30px; flex-wrap: wrap; }
  .hero-note { margin-top: 16px; font-size: 12.5px; color: var(--ink-faint); font-family: var(--mono); }

  /* ledger-page mockup */
  .ledger-frame {
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    box-shadow: 0 20px 50px -20px var(--shadow);
    overflow: hidden;
    opacity: 0; transform: translateY(18px) rotate(1deg);
    animation: rise .8s cubic-bezier(.2,.7,.2,1) .15s forwards;
  }
  @keyframes rise { to { opacity: 1; transform: translateY(0) rotate(0.6deg); } }
  .ledger-frame .bar {
    display: flex; align-items: center; gap: 6px;
    padding: 9px 12px; border-bottom: 1px solid var(--line);
    font-family: var(--mono); font-size: 10.5px; color: var(--ink-faint);
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--line-strong); }

  /* ============ PRINCIPLES STRIP ============ */
  .principles {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .principles-inner {
    display: flex; flex-wrap: wrap; gap: 10px 34px;
    padding: 18px 0; justify-content: center;
    font-family: var(--mono); font-size: 12px; letter-spacing: .05em; text-transform: uppercase;
    color: var(--ink-soft);
  }
  .principles-inner span { white-space: nowrap; }
  .principles-inner b { color: var(--ink); }

  /* ============ SECTION HEADS ============ */
  .section { padding: 84px 0; }
  .section-head { max-width: 56ch; margin-bottom: 44px; }
  .section-head h2 { font-size: clamp(26px, 3.4vw, 34px); margin-top: 8px; }
  .section-head p { margin-top: 12px; color: var(--ink-soft); font-size: 16px; }

  /* ============ FEATURE LEDGER ============ */
  .folio { border-top: 1px solid var(--line-strong); }
  .folio-row {
    display: grid;
    grid-template-columns: 78px 1fr auto;
    gap: 20px;
    align-items: start;
    padding: 26px 4px;
    border-bottom: 1px solid var(--line);
    opacity: 0; transform: translateY(14px);
    transition: opacity .5s ease, transform .5s ease;
  }
  .folio-row.in { opacity: 1; transform: translateY(0); }
  .folio-no { font-family: var(--mono); font-size: 12.5px; color: var(--ink-faint); padding-top: 4px; }
  .folio-icon { width: 34px; height: 34px; flex-shrink: 0; }
  .folio-body h3 { font-family: var(--sans); font-weight: 650; font-size: 17px; margin-bottom: 5px; }
  .folio-body p { margin: 0; color: var(--ink-soft); font-size: 14.8px; max-width: 60ch; }
  .folio-main { display: flex; gap: 16px; }
  .folio-tag {
    font-family: var(--mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase;
    color: var(--brass); white-space: nowrap; padding-top: 4px;
  }

  /* running balance */
  .balance-rail {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-top: 28px; padding-top: 18px; border-top: 2px solid var(--ink);
    font-family: var(--mono);
  }
  .balance-rail .label { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); }
  .balance-rail .value { font-size: 22px; color: var(--red); }

  /* ============ WORKFLOW ============ */
  .workflow-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;
  }
  @media (max-width: 780px) { .workflow-grid { grid-template-columns: 1fr; } }
  .workflow-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 26px 22px;
    background: var(--paper-raised);
    opacity: 0; transform: translateY(14px);
    transition: opacity .5s ease, transform .5s ease;
  }
  .workflow-card.in { opacity: 1; transform: translateY(0); }
  .workflow-num { font-family: var(--serif); font-size: 28px; color: var(--line-strong); }
  .workflow-card h3 { font-family: var(--sans); font-size: 16.5px; font-weight: 650; margin: 10px 0 8px; }
  .workflow-card p { margin: 0; color: var(--ink-soft); font-size: 14.6px; }

  /* ============ ROLES ============ */
  .roles-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  @media (max-width: 700px) { .roles-grid { grid-template-columns: 1fr; } }
  .role-col { padding: 30px 28px; }
  .role-col + .role-col { border-left: 1px solid var(--line-strong); }
  @media (max-width: 700px) { .role-col + .role-col { border-left: none; border-top: 1px solid var(--line-strong); } }
  .role-col.admin { background: var(--paper-raised); }
  .role-tag {
    display: inline-block; font-family: var(--mono); font-size: 11px; letter-spacing: .08em;
    text-transform: uppercase; padding: 3px 9px; border-radius: 999px;
    border: 1px solid currentColor;
  }
  .role-col.admin .role-tag { color: var(--brass); }
  .role-col.agent .role-tag { color: var(--red); }
  .role-col h3 { font-family: var(--serif); font-size: 21px; margin: 12px 0 16px; }
  .role-col ul { margin: 0; padding: 0; list-style: none; }
  .role-col li {
    font-size: 14.6px; color: var(--ink-soft); padding: 9px 0;
    border-top: 1px dashed var(--line);
    display: flex; gap: 9px;
  }
  .role-col li:first-of-type { border-top: none; }
  .role-col li::before { content: "—"; color: var(--ink-faint); flex-shrink: 0; }

  /* ============ CTA / CONTACT ============ */
  .cta-section {
    background: var(--ink);
    color: var(--paper);
  }
  .cta-inner { padding: 84px 0; text-align: center; }
  .cta-inner .eyebrow { color: color-mix(in srgb, var(--paper) 55%, transparent); }
  .cta-inner h2 {
    color: var(--paper); font-size: clamp(26px, 4vw, 38px); margin-top: 10px;
  }
  .cta-inner p { color: color-mix(in srgb, var(--paper) 70%, transparent); margin: 14px auto 0; max-width: 50ch; }
  .contact-row {
    margin-top: 34px; display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;
  }
  .contact-card {
    border: 1px solid color-mix(in srgb, var(--paper) 30%, transparent);
    border-radius: var(--radius-md);
    padding: 16px 22px;
    text-decoration: none;
    color: var(--paper);
    font-family: var(--mono);
    font-size: 14px;
    display: flex; align-items: center; gap: 10px;
    transition: border-color .15s ease, transform .15s ease;
  }
  .contact-card:hover { border-color: var(--brass); transform: translateY(-2px); }
  .contact-card .k { color: color-mix(in srgb, var(--paper) 55%, transparent); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; display: block; margin-bottom: 2px; }

  .seal {
    width: 64px; height: 64px; margin: 0 auto 18px;
    border: 2px solid var(--brass); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--brass); font-family: var(--serif); font-weight: 700; font-size: 11px;
    transform: rotate(-8deg);
    letter-spacing: .05em; text-align: center; line-height: 1.15;
  }

  footer.site-foot {
    padding: 22px 0 40px; text-align: center;
    font-family: var(--mono); font-size: 11.5px; color: color-mix(in srgb, var(--paper) 45%, transparent);
    background: var(--ink);
  }
  footer.site-foot a { text-decoration: none; color: inherit; }
  footer.site-foot a:hover { color: var(--brass); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .ledger-frame { animation: none; opacity: 1; transform: none; }
    .folio-row, .workflow-card { transition: none; opacity: 1; transform: none; }
  }
</style>
</head>
<body>

<nav class="nav">
  <div class="container nav-inner">
    <a class="brand" href="#top">
      <span class="brand-mark" aria-hidden="true">RD</span>
      <span class="brand-name">Retail Due Manager</span>
    </a>
    <div class="nav-links">
      <a href="#features">Features</a>
      <a href="#how">How it works</a>
      <a href="#roles">Roles</a>
      <a href="#contact">Contact</a>
    </div>
    <a class="stamp-btn" href="#contact">Get in touch</a>
  </div>
</nav>

<main id="top">
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Ledger No. 001 · Est. for shopkeepers, not accountants</p>
        <h1>Every rupee owed, <em>accounted for</em> — even offline.</h1>
        <p class="hero-sub">
          Retail Due Manager keeps your parties, invoices, payments and dues in one
          ledger that always balances — on the shop floor, in the field, with or
          without an internet connection.
        </p>
        <div class="hero-cta">
          <a class="stamp-btn solid" href={downloadUrl} download>Download for Windows</a>
          <a class="stamp-btn" href="#features" style="transform:rotate(1deg);">See what it does</a>
        </div>
        <p class="hero-note">v0.1.0 · Windows installer (.exe) · ~94 MB · Your data stays on your machine</p>
      </div>

      <div class="ledger-frame" role="img" aria-label="Mockup of the Retail Due Manager sales invoice screen, showing a ledger table with item, invoice number, quantity, rate and amount columns, and a running total.">
        <div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span style="margin-left:6px;">Retail Due Manager — Sales Invoice</span></div>
        <svg viewBox="0 0 480 340" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="0" y="0" width="480" height="340" fill="var(--paper-raised)"/>
          <text x="20" y="30" font-family="Georgia, serif" font-size="16" font-weight="700" fill="var(--ink)">Sri Balaji Traders</text>
          <text x="20" y="48" font-size="11" fill="var(--ink-faint)" font-family="monospace">98765 43210 · Balance ₹ 18,240.00</text>
          <text x="460" y="30" font-size="11" fill="var(--brass)" font-family="monospace" text-anchor="end">INV/25-26/0192</text>

          <line x1="20" y1="66" x2="460" y2="66" stroke="var(--line-strong)" stroke-width="1"/>
          <text x="20" y="82" font-size="10" fill="var(--ink-faint)" font-family="monospace" letter-spacing="1">ITEM / DESCRIPTION</text>
          <text x="330" y="82" font-size="10" fill="var(--ink-faint)" font-family="monospace" letter-spacing="1">QTY</text>
          <text x="380" y="82" font-size="10" fill="var(--ink-faint)" font-family="monospace" letter-spacing="1">RATE</text>
          <text x="460" y="82" font-size="10" fill="var(--ink-faint)" font-family="monospace" letter-spacing="1" text-anchor="end">AMOUNT</text>
          <line x1="20" y1="92" x2="460" y2="92" stroke="var(--line)" stroke-width="1"/>

          <g font-size="12.5" fill="var(--ink)" font-family="Georgia, serif">
            <text x="20" y="114">Basmati Rice 25kg</text>
            <text x="345" y="114" text-anchor="end" font-family="monospace">4</text>
            <text x="405" y="114" text-anchor="end" font-family="monospace">1,120</text>
            <text x="460" y="114" text-anchor="end" font-family="monospace">4,480.00</text>
          </g>
          <line x1="20" y1="126" x2="460" y2="126" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 3"/>

          <g font-size="12.5" fill="var(--ink)" font-family="Georgia, serif">
            <text x="20" y="148">Sunflower Oil 15L Tin</text>
            <text x="345" y="148" text-anchor="end" font-family="monospace">6</text>
            <text x="405" y="148" text-anchor="end" font-family="monospace">2,150</text>
            <text x="460" y="148" text-anchor="end" font-family="monospace">12,900.00</text>
          </g>
          <line x1="20" y1="160" x2="460" y2="160" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 3"/>

          <g font-size="12.5" fill="var(--ink-soft)" font-family="Georgia, serif">
            <text x="20" y="182">Invoice No. INV/25-26/0140</text>
            <text x="345" y="182" text-anchor="end" font-family="monospace">1</text>
            <text x="405" y="182" text-anchor="end" font-family="monospace">2,600</text>
            <text x="460" y="182" text-anchor="end" font-family="monospace">2,600.00</text>
          </g>

          <line x1="20" y1="204" x2="460" y2="204" stroke="var(--ink)" stroke-width="1.5"/>
          <text x="380" y="228" font-size="11" fill="var(--ink-faint)" font-family="monospace">TOTAL</text>
          <text x="460" y="228" font-size="16" fill="var(--red)" font-family="monospace" font-weight="700" text-anchor="end">₹ 19,980.00</text>

          <rect x="20" y="252" width="118" height="24" rx="12" fill="none" stroke="var(--line-strong)"/>
          <circle cx="34" cy="264" r="3.5" fill="var(--brass)"/>
          <text x="44" y="268" font-size="10" fill="var(--ink-soft)" font-family="monospace">SAVED OFFLINE</text>

          <rect x="146" y="252" width="112" height="24" rx="12" fill="none" stroke="var(--line-strong)"/>
          <text x="166" y="268" font-size="10" fill="var(--ink-soft)" font-family="monospace">LEDGER BALANCED</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- ============ PRINCIPLES ============ -->
  <div class="principles">
    <div class="container principles-inner">
      <span><b>Offline-first,</b> always</span>
      <span>The <b>ledger</b> always balances</span>
      <span>Built for <b>non-technical</b> shopkeepers</span>
      <span>Boringly <b>reliable</b></span>
    </div>
  </div>

  <!-- ============ FEATURES (as ledger folio) ============ -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What's posted to your ledger</p>
        <h2>Six entries, one account book.</h2>
        <p>Everything a retail or wholesale counter needs to track what's owed — nothing it doesn't.</p>
      </div>

      <div class="folio" id="folio">
        <div class="folio-row">
          <div class="folio-no tabular">01</div>
          <div class="folio-main">
            <svg class="folio-icon" viewBox="0 0 34 34" aria-hidden="true"><rect x="4" y="5" width="26" height="24" rx="2" fill="none" stroke="var(--brass)" stroke-width="1.6"/><line x1="9" y1="12" x2="25" y2="12" stroke="var(--brass)" stroke-width="1.4"/><line x1="9" y1="17" x2="25" y2="17" stroke="var(--brass)" stroke-width="1.4"/><line x1="9" y1="22" x2="19" y2="22" stroke="var(--brass)" stroke-width="1.4"/></svg>
            <div class="folio-body">
              <h3>Sales invoices</h3>
