<meta property="og:description" content="Offline-first due &amp; ledger management for retail and wholesale shops. Every entry balances, every rupee is accounted for — online or off.">
<meta property="og:locale" content="en_IN">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Retail Due Manager">
