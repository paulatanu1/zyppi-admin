---
import Site from '../layouts/Site.astro';
---
<Site title="Contact Zyppi" description="Questions about an order, selling on Zyppi or riding with us? Write to the Zyppi team in Chelyama." path="/contact" active="contact" scenes={true}>
<div class="page" data-page="contact">
  <section class="hero gutter">
    <div class="wrap grid">
      <div class="copy">
        <span class="kicker"><i></i><span data-en="We're here to help" data-bn="আমরা সাহায্যের জন্য আছি">We're here to help</span></span>
        <h1>
          <span class="line"><span data-en="Talk to us." data-bn="আমাদের সঙ্গে">Talk to us.</span></span>
          <span class="line"><span class="pink" data-en="We're listening." data-bn="কথা বলুন।">We're listening.</span></span>
        </h1>
        <p class="lead" data-en="Questions about an order, selling on Zyppi or riding with us? Send a message and the team in Chelyama will get back to you." data-bn="অর্ডার, Zyppi-তে বিক্রি বা রাইড নিয়ে প্রশ্ন? বার্তা পাঠান, চেলিয়ামার টিম আপনার সঙ্গে যোগাযোগ করবে।">Questions about an order, selling on Zyppi or riding with us? Send a message and the team in Chelyama will get back to you.</p>
      </div>
      <div class="visual" aria-hidden="true"><canvas data-scene="contact"></canvas></div>
    </div>
  </section>
  <section class="sec tight gutter get">
    <div class="wrap grid">
      <div class="contact">
        <form class="form" id="contactForm" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="contact">
          <p hidden><label>Leave this empty <input name="bot-field"></label></p>
          <div class="row2">
            <label class="field" for="cf-name"><span data-en="Your name" data-bn="আপনার নাম">Your name</span><input id="cf-name" name="name" type="text" autocomplete="name" required></label>
            <label class="field" for="cf-phone"><span data-en="Phone number" data-bn="ফোন নম্বর">Phone number</span><input id="cf-phone" name="phone" type="tel" autocomplete="tel"></label>
          </div>
          <label class="field" for="cf-topic"><span data-en="I am" data-bn="আমি">I am</span>
            <select id="cf-topic" name="topic"><option data-en="A customer" data-bn="ক্রেতা">A customer</option><option data-en="A shop owner" data-bn="দোকানদার">A shop owner</option><option data-en="A rider" data-bn="রাইডার">A rider</option><option data-en="Something else" data-bn="অন্য কিছু">Something else</option></select></label>
          <label class="field" for="cf-msg"><span data-en="Message" data-bn="বার্তা">Message</span><textarea id="cf-msg" name="message" required></textarea></label>
          <div class="thanks" id="cfThanks" role="status" hidden data-en="Thanks. We'll get back to you soon." data-bn="ধন্যবাদ। শীঘ্রই যোগাযোগ করব।">Thanks. We'll get back to you soon.</div>
          <div class="thanks err" id="cfError" role="alert" hidden></div>
          <button class="submit" type="submit" data-en="Send message" data-bn="বার্তা পাঠান">Send message</button>
        </form>
        <div class="side">
          <div class="info"><small data-en="Email" data-bn="ইমেল">Email</small><div class="row"><b class="sel" id="mail">admin@zyppi.in</b><button class="copy-btn" type="button" id="copyMail" data-en="Copy" data-bn="কপি">Copy</button></div></div>
          <div class="info"><small data-en="In the app" data-bn="অ্যাপে">In the app</small><b data-en="Account → Help" data-bn="অ্যাকাউন্ট → সাহায্য">Account → Help</b></div>
          <div class="info"><small data-en="Where we deliver" data-bn="আমরা যেখানে ডেলিভারি করি">Where we deliver</small><b data-en="Chelyama" data-bn="চেলিয়ামা">Chelyama</b></div>
          <div class="info"><small data-en="Want to ride with us?" data-bn="রাইডার হতে চান?">Want to ride with us?</small><a href="https://admin.zyppi.in/rider" target="_blank" rel="noopener" data-en="Register as a rider →" data-bn="রাইডার হিসেবে রেজিস্টার করুন →">Register as a rider →</a></div>
        </div>
      </div>
    </div>
  </section>
</div>
</Site>
